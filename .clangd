CompileFlags:
  CompilationDatabase: build
Diagnostics:
  ClangTidy:
    Add:
      [
        "clang-analyzer-*",
        "performance-*",
        "bugprone-*",
        "readability-*",
        "modernize-*",
      ]
    Remove:
      ["readability-magic-numbers", "cppcoreguidelines-avoid-magic-numbers"]
